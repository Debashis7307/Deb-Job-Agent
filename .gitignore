# ============================================
# .gitignore for Job Application AI Agent
# ============================================

# Secrets - NEVER commit these
.env
*.env

# Resume (private document)
data/resume.pdf
data/*.pdf

# HR contact list (contains personal emails — privacy sensitive)
data/hr_contacts_from_pdf.csv
data/mem0_cache.json
data/mem0_sync.json

# Temp/utility scripts
scan_secrets.py
fix_pdf_db.py

# Database (contains personal data)
database/tracker.db
database/*.db

# Logs
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.sqlite3
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
mypy_cache/
pip-wheel-metadata/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Playwright
playwright-report/
test-results/

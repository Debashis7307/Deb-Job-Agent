# ============================================
# .env.template — Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================

# ─── Gemini AI ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash   # Flash is FREE (Pro is now paid)

# ─── Gmail (for sending cold emails) ────────
# Use a DEDICATED job-hunt Gmail (e.g., yourname.jobs@gmail.com)
# To get App Password: Gmail → Account → Security → 2-Step → App Passwords
GMAIL_ADDRESS=yourname.jobs@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ─── mem0 (optional - cloud memory) ────────
# Sign up FREE at https://mem0.ai
MEM0_API_KEY=your_mem0_api_key_here
MEM0_USER_ID=job_agent_user_001

# ─── B2B Email Search & Verification APIs ───
APOLLO_API_KEY=your_apollo_api_key_here
SNOV_CLIENT_ID=your_snov_user_id_here
SNOV_CLIENT_SECRET=your_snov_secret_key_here

# ─── LinkedIn (for LinkedIn Easy Apply) ─────
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password

# ─── Naukri ─────────────────────────────────
NAUKRI_EMAIL=your_naukri_email@gmail.com
NAUKRI_PASSWORD=your_naukri_password

# ─── Settings ───────────────────────────────
DRY_RUN=True                    # Set to False for real applying
MAX_APPLY_PER_DAY=30
MAX_EMAIL_PER_DAY=25
SCHEDULE_HOUR=22                # Run at 10 PM daily (22:00 IST)
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Kolkata

# ─── Dashboard ─────────────────────────────
DASHBOARD_PASSWORD=your_secret_password_here   # Password to manually trigger the agent
DASHBOARD_SECRET_KEY=your_flask_secret_key_here
DASHBOARD_PORT=5000

# ─── Cloud Hosting (for Render.com) ──────────
# GH_PAT=your_github_personal_access_token     # Set in Render env vars (NOT here)
